# Never commit a real key. Copy this file to .env and fill in your values.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
DATA_DIR=./data

# Local speech recognition is the default fallback when a video has no captions.
# auto = local Whisper first, OpenAI only if local is unavailable.
# local = never send audio to OpenAI; openai = use the OpenAI transcription API.
TRANSCRIBE_PROVIDER=auto
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_MODEL_DIR=./models

# Local text generation. Ollama is preferred in auto mode when it is running.
# Use `ollama pull qwen3:8b` before starting the app.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Cloud deployment: any OpenAI-compatible chat API can be used.
# Set LLM_PROVIDER=compatible and keep the real key only in the cloud secret manager.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# Required when the app is publicly accessible.
APP_ACCESS_USER=student
APP_ACCESS_PASSWORD=

# Optional: yt-dlp Netscape cookie file for sources that require your own login.
# It is read locally and must never be committed or shared.
YTDLP_COOKIEFILE=

# Optional: enables the WeCom callback endpoint. Configure the same values in WeCom.
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=

